# Localflix — Docker Compose environment (used by docker-compose.yml at the
# project root). Copy this file to ".env" in the SAME directory as
# docker-compose.yml (the project root), then edit the values below.
#
# This is a DIFFERENT file from data/mysql/.env — that one is only used by
# the "Manual Setup" path in the README (running MySQL alone in Docker while
# the app runs directly with `node server.js`). If you're following the
# "Quick Start (Docker)" instructions, this root .env is the one you need.

# MySQL root password. Also used by the app to connect as root (the app
# always connects as the MySQL "root" user — see scripts/dbConfig.js).
MYSQL_ROOT_PASSWORD=change_me_root_password

# Database name — must match what's created by data/mysql/schema.sql
MYSQL_DATABASE=localflix

# MySQL host, as seen from inside the "app" container. Must be "db" (the
# docker-compose service name for MySQL) — NOT "localhost", which inside a
# container refers to the app container itself, not the database container.
HOST=db

# How many ffmpeg encode jobs can run at the same time. Extra jobs wait in a
# FIFO queue instead of competing for CPU. 1 is a safe default for typical
# self-hosted hardware — only raise this if the machine has real headroom for
# multiple simultaneous encodes.
MAX_CONCURRENT_ENCODES=1
