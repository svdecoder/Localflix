# Localflix Database Configuration
# Copy this file to .env and fill in your values

# MySQL root password (required)
MYSQL_ROOT_PASSWORD=change_me_root_password

# MySQL user password (required — must match MYSQL_ROOT_PASSWORD for the app)
MYSQL_PASSWORD=change_me_user_password

# Database name
DATABASE=localflix

# MySQL host (use "localhost" for local dev, "db" for Docker Compose)
HOST=localhost